# CloudSight production runtime template. Never place live values here.
NODE_ENV=production
POSTGRES_DB=cloudsight
POSTGRES_USER=cloudsight
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=CHANGE_ME
JWT_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
CORS_ORIGIN=CHANGE_ME
REFRESH_COOKIE_SAME_SITE=lax
FRONTEND_AUTH_COMPLETE_URL=

# Optional OAuth providers remain disabled when every provider value is blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_REDIRECT_URI=
ENTRA_ALLOWED_TENANT_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

GHCR_USERNAME=CHANGE_ME
GHCR_TOKEN=CHANGE_ME
CLIENT_IMAGE=ghcr.io/nathanlouissaint/cloudsight-client:latest
SERVER_IMAGE=ghcr.io/nathanlouissaint/cloudsight-server:latest
