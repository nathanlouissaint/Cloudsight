# Vite variables are embedded at build time. Do not place server secrets here.

# Same-origin Nginx API proxy for Docker and production deployments.
VITE_API_URL=/api

# Optional product analytics. The PostHog project key is public by design;
# leave both values empty to disable analytics safely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional external Website Strategy Call booking link. Leave empty to show
# confirmation only; no booking button will be rendered.
VITE_WEBSITE_AUDIT_BOOKING_URL=
