# Local production-style Docker Compose configuration.
# Copy this file to .env and replace every placeholder before starting services.

POSTGRES_USER=cloudsight
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=cloudsight

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CORS_ORIGIN=http://localhost:3000
CLIENT_PORT=3000

# Required only by docker-compose.prod.yml. Build and publish this image from
# server/Dockerfile with the `migrator` target.
SERVER_MIGRATOR_IMAGE=cloudsight-server-migrator:latest

AWS_PROVIDER=aws
AWS_REGION=us-east-1

# Optional error monitoring.
SENTRY_DSN=
SENTRY_RELEASE=
