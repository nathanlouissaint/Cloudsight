DATABASE_URL=
# Dedicated disposable PostgreSQL target for integration tests only.
TEST_DATABASE_URL=postgresql://cloudsight_test_user:cloudsight_test_password@127.0.0.1:5434/cloudsight_test?schema=public

CORS_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SAME_SITE=lax

# Use a cryptographically random secret of at least 32 bytes for non-development deployments.
CSRF_SECRET=

AWS_PROVIDER=mock

AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Google federated authentication. Set all three values to enable it.
# Example callback: http://localhost:5001/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional Microsoft Entra foundation (Phase 3.2.1). Set every value to enable;
# partial configuration fails closed. Only organizations authority and explicit
# comma-separated tenant GUIDs are accepted. Protocol implementation is later.
# Example authority: organizations
# Example callback: http://localhost:5001/auth/oauth/microsoft/callback
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_REDIRECT_URI=
ENTRA_ALLOWED_TENANT_IDS=

# Optional GitHub OAuth App sign-in foundation (Phase 3.3.1). Set all three
# values to enable configuration; partial or invalid configuration fails closed.
# GitHub protocol behavior is implemented in Phase 3.3.2.
# Example callback: http://localhost:5001/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
