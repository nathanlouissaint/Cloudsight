# Required in production
NODE_ENV=production
PORT=5001
DATABASE_URL=postgresql://cloudsight:replace_with_a_strong_password@postgres:5432/cloudsight?schema=public
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ISSUER=cloudsight-api
JWT_AUDIENCE=cloudsight-web
REDIS_URL=redis://redis:6379
CORS_ORIGIN=https://app.example.com
AUTH_COOKIE_SAMESITE=lax

# AWS authentication should use the workload identity or AWS credential chain.
# Do not commit long-lived AWS access keys.
AWS_PROVIDER=aws
AWS_REGION=us-east-1

# Mock AWS is for local development only and is ignored in production.
SPEND_GUARD_MOCK_AWS=false

# Optional error monitoring.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional internal Website Audit lead notifications through Resend. When any
# value is absent, delivery is disabled and persisted leads still succeed.
WEBSITE_AUDIT_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
