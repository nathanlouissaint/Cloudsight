# Required in production
NODE_ENV=production
PORT=5001
DATABASE_URL=postgresql://cloudsight:replace_with_a_strong_password@postgres:5432/cloudsight?schema=public
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ISSUER=cloudsight-api
JWT_AUDIENCE=cloudsight-web
REDIS_URL=redis://redis:6379
CORS_ORIGIN=https://app.example.com
AUTH_COOKIE_SAMESITE=lax

# AWS authentication should use the workload identity or AWS credential chain.
# Do not commit long-lived AWS access keys.
AWS_PROVIDER=aws
AWS_REGION=us-east-1

# Mock AWS is for local development only and is ignored in production.
SPEND_GUARD_MOCK_AWS=false

# Optional error monitoring.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional internal Website Audit lead notifications through Resend. When any
# value is absent, delivery is disabled and persisted leads still succeed.
WEBSITE_AUDIT_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=

# Website Audit API and isolated worker. Do not set
# AUDIT_CRAWLER_NETWORK_ISOLATION=enabled until network-enforced egress controls
# have been deployed and verified for the crawler worker.
WEBSITE_AUDIT_TOKEN_SECRET=replace_with_a_random_secret
AUDIT_CRAWLER_NETWORK_ISOLATION=
# URL of the worker's network-enforced egress proxy. It must independently
# resolve and reject private, link-local, metadata, and reserved destinations.
# Do not point this at a general-purpose corporate proxy without those controls.
AUDIT_CRAWLER_EGRESS_PROXY_URL=
# Optional brokered-worker mode: the crawler receives this scoped token but no
# DATABASE_URL, OPENAI_API_KEY, JWT_SECRET, or other application credentials.
AUDIT_WORKER_BROKER_URL=
AUDIT_WORKER_BROKER_TOKEN=
WEBSITE_AUDIT_GLOBAL_CONCURRENCY=2
WEBSITE_AUDIT_DOMAIN_CONCURRENCY=1
WEBSITE_AUDIT_ROBOTS_CACHE_TTL_MS=300000

# Optional AI recommendations. These values belong only to the isolated audit
# worker. Keep AI disabled unless both values are configured.
WEBSITE_AUDIT_AI_ENABLED=
WEBSITE_AUDIT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
