{
  "name": "cloudsight-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:registration": "node --import tsx --test test/registration.integration.test.ts",
    "test:budget": "node --import tsx --test test/budget.integration.test.ts",
    "test:cloud-account": "node --import tsx --test test/cloud-account.integration.test.ts",
    "test:collection": "node --import tsx --test test/collection.integration.test.ts",
    "test:spend-guard-analysis": "node --import tsx --test test/spend-guard-analysis.integration.test.ts",
    "test:website-audit": "node --import tsx --test test/website-audit-lead.integration.test.ts",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down",
    "test:db:migrate": "DATABASE_URL=\"${TEST_DATABASE_URL:?TEST_DATABASE_URL is required}\" prisma migrate deploy",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1075.0",
    "@aws-sdk/client-cost-explorer": "^3.1075.0",
    "@aws-sdk/client-organizations": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1132.0",
    "@faker-js/faker": "^10.5.0",
    "@prisma/client": "^6.10.1",
    "@sentry/node": "^11.1.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.10.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
