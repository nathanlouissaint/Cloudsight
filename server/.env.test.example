# Test-only PostgreSQL. This must never point at development or production.
TEST_DATABASE_URL=postgresql://cloudsight_test_user:cloudsight_test_password@127.0.0.1:5434/cloudsight_test?schema=public

# Values used by docker-compose.test.yml. These are isolated local test credentials.
TEST_POSTGRES_USER=cloudsight_test_user
TEST_POSTGRES_PASSWORD=cloudsight_test_password
TEST_POSTGRES_DB=cloudsight_test
