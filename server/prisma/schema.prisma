generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  passwordHash           String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  authProvider           AuthProvider             @default(LOCAL)
  avatarUrl              String?
  googleId               String?                  @unique
  name                   String?
  emailVerifiedAt        DateTime?
  AuthIdentity           AuthIdentity[]
  EmailVerificationToken EmailVerificationToken[]
  OrganizationInvitation OrganizationInvitation[]
  OrganizationMember     OrganizationMember[]
  PasswordResetToken     PasswordResetToken[]
  SecurityAudit          SecurityAudit[]
  Session                Session[]
}

model WebsiteAuditLead {
  id                 String                  @id @default(uuid())
  firstName          String
  lastName           String
  workEmail          String
  company            String
  websiteUrl         String
  companyDescription String
  websiteProblem     String
  launchTimeline     String
  budgetRange        String
  status             WebsiteAuditLeadStatus  @default(NEW)
  source             WebsiteAuditLeadSource  @default(WEBSITE_AUDIT_FUNNEL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([workEmail, websiteUrl, createdAt])
  @@index([status, createdAt])
}

model CloudAccount {
  id                      String                @id @default(uuid())
  awsAccountId            String                @unique
  accountName             String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organizationId          String
  disconnectedAt          DateTime?
  isActive                Boolean               @default(true)
  connectionError         String?
  connectionStatus        String                @default("NOT_CONFIGURED")
  externalId              String?
  lastVerifiedAt          DateTime?
  roleArn                 String?
  collectionError         String?
  lastCollectionAttemptAt DateTime?
  lastSuccessfulSyncAt    DateTime?
  Organization            Organization          @relation(fields: [organizationId], references: [id])
  snapshots               CostSnapshot[]
  serviceSnapshots        ServiceCostSnapshot[]

  @@index([organizationId])
}

model CostSnapshot {
  id           String       @id @default(uuid())
  accountId    String
  snapshotDate DateTime
  totalCost    Float
  createdAt    DateTime     @default(now())
  account      CloudAccount @relation(fields: [accountId], references: [id])

  @@index([snapshotDate])
  @@unique([accountId, snapshotDate])
}

model ServiceCostSnapshot {
  id           String       @id @default(uuid())
  accountId    String
  serviceName  String
  snapshotDate DateTime
  cost         Float
  createdAt    DateTime     @default(now())
  account      CloudAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([accountId, snapshotDate])
  @@index([snapshotDate])
  @@index([serviceName])
  @@unique([accountId, serviceName, snapshotDate])
}

model Budget {
  id             String       @id @default(uuid())
  name           String
  amount         Float
  month          Int
  year           Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

model AlertHistory {
  id             String       @id @default(uuid())
  alertId        String
  type           String
  severity       String
  status         String
  title          String
  description    String
  recommendation String
  metric         String
  currentValue   Float
  threshold      Float
  occurredAt     DateTime
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([alertId])
  @@index([severity])
  @@index([status])
  @@index([occurredAt])
  @@index([organizationId])
}

model ReportNote {
  id             String       @id @default(uuid())
  title          String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
}

model AuthIdentity {
  id                    String                @id
  userId                String
  providerKind          FederatedProviderKind
  issuer                String
  providerSubject       String
  providerEmail         String?
  providerEmailVerified Boolean?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  User                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, providerSubject])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Organization {
  id                     String                   @id
  name                   String
  slug                   String                   @unique
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  AlertHistory           AlertHistory[]
  Budget                 Budget[]
  CloudAccount           CloudAccount[]
  OrganizationInvitation OrganizationInvitation[]
  OrganizationMember     OrganizationMember[]
  ReportNote             ReportNote[]

  @@index([createdAt])
}

model OrganizationInvitation {
  id              String           @id
  organizationId  String
  email           String
  role            OrganizationRole @default(MEMBER)
  tokenHash       String           @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  User            User             @relation(fields: [invitedByUserId], references: [id])
  Organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@index([organizationId])
}

model OrganizationMember {
  id             String           @id
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([userId, organizationId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model SecurityAudit {
  id         String         @id
  userId     String
  eventType  AuditEventType
  ipAddress  String?
  userAgent  String?
  deviceName String?
  createdAt  DateTime       @default(now())
  User       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([eventType])
  @@index([userId])
}

model Session {
  id               String    @id
  userId           String
  tokenFamilyId     String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  deviceName       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedAt       DateTime?
  replacedBySessionId String?
  reuseDetectedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  lastUsedAt       DateTime  @default(now())
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId])
  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
}

enum AuditEventType {
  LOGIN
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  GITHUB
}

enum FederatedProviderKind {
  GOOGLE
  MICROSOFT
  GITHUB
  OIDC
  SAML
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WebsiteAuditLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CALL_BOOKED
  PROPOSAL_SENT
  WON
  LOST
}

enum WebsiteAuditLeadSource {
  WEBSITE_AUDIT_FUNNEL
}
