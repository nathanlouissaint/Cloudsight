generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  GITHUB
}

enum FederatedProviderKind {
  GOOGLE
  MICROSOFT
  GITHUB
  OIDC
  SAML
}

enum AuditEventType {
  LOGIN
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String?

  authProvider AuthProvider @default(LOCAL)

  googleId String? @unique

  name String?

  avatarUrl String?

  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  sessions Session[]

  authIdentities AuthIdentity[]

  securityAudits SecurityAudit[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationTokens EmailVerificationToken[]

  memberships OrganizationMember[]
}

model Organization {
  id String @id @default(uuid())

  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMember[]
  cloudAccounts CloudAccount[]
  budgets       Budget[]
  alertHistory  AlertHistory[]
  reportNotes   ReportNote[]

  @@index([createdAt])
}

model OrganizationMember {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrganizationRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([userId, organizationId])
}

model AuthIdentity {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerKind    FederatedProviderKind
  issuer          String
  providerSubject String

  providerEmail         String?
  providerEmailVerified Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, providerSubject])
  @@index([userId])
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  ipAddress  String?
  userAgent  String?
  deviceName String?

  expiresAt DateTime
  revokedAt DateTime?

  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt])
}

model SecurityAudit {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType AuditEventType

  ipAddress  String?
  userAgent  String?
  deviceName String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CloudAccount {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  awsAccountId String @unique
  accountName  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots        CostSnapshot[]
  serviceSnapshots ServiceCostSnapshot[]

  @@index([organizationId])
}

model CostSnapshot {
  id String @id @default(uuid())

  accountId String
  account   CloudAccount @relation(fields: [accountId], references: [id])

  snapshotDate DateTime
  totalCost    Float

  createdAt DateTime @default(now())

  @@index([snapshotDate])
}

model ServiceCostSnapshot {
  id String @id @default(uuid())

  accountId String
  account   CloudAccount @relation(fields: [accountId], references: [id])

  serviceName String

  snapshotDate DateTime
  cost         Float

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([snapshotDate])
  @@index([serviceName])
}

model Budget {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name   String
  amount Float

  month Int
  year  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

model AlertHistory {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  alertId  String
  type     String
  severity String
  status   String

  title          String
  description    String
  recommendation String

  metric       String
  currentValue Float
  threshold    Float

  occurredAt DateTime
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([alertId])
  @@index([severity])
  @@index([status])
  @@index([occurredAt])
}

model ReportNote {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdAt])
}
