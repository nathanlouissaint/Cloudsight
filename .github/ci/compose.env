# Deliberately non-secret, disposable values used only by GitHub Actions Compose validation and smoke tests.
POSTGRES_PASSWORD=cloudsight_ci_password
DATABASE_URL=postgresql://cloudsight:cloudsight_ci_password@postgres:5432/cloudsight
REDIS_URL=redis://redis:6379
JWT_SECRET=cloudsight-ci-not-for-production
CORS_ORIGIN=http://localhost:3000
AWS_REGION=us-east-1
SERVER_MIGRATOR_IMAGE=cloudsight-server-ci
SERVER_IMAGE=cloudsight-server-ci
CLIENT_IMAGE=cloudsight-client-ci
